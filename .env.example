# Copy to .env and fill in. .env is gitignored -- never commit a real key.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# Two models, split by what each call needs. FAST does intent extraction and the
# fuzzy-condition judge (constrained classification); COMPOSE writes the user-facing
# prose. Splitting them also spreads usage across two per-model quota buckets, which
# matters on the free tier where the daily allowance is counted per model.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_COMPOSE=gemini-3.5-flash

# Optional
HTTP_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=3
